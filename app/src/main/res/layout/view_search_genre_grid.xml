<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_genre_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Trending Searches -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 Trending Searches"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/trending_pushpa"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/glass_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🔥 Pushpa 2"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/trending_ipl"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/glass_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🏏 IPL Live"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/trending_gujarati"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/glass_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🎭 Gujarati Natak"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/trending_bollywood"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/glass_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🎬 Stree 2"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Browse Categories / Genres Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Explore Categories"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- 2-Column Genre Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:useDefaultMargins="true"
        android:alignmentMode="alignMargins">

        <!-- Action Card -->
        <FrameLayout
            android:id="@+id/genre_card_action"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/genre_gradient_action"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="💥 Action"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Gujarati Card -->
        <FrameLayout
            android:id="@+id/genre_card_gujarati"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/genre_gradient_gujarati"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🎭 Gujarati"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Bollywood Card -->
        <FrameLayout
            android:id="@+id/genre_card_bollywood"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/genre_gradient_bollywood"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🎬 Bollywood"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- South Hindi Card -->
        <FrameLayout
            android:id="@+id/genre_card_south"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/genre_gradient_south"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🌟 South Dubbed"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Live Sports Card -->
        <FrameLayout
            android:id="@+id/genre_card_sports"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/genre_gradient_sports"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🏏 Live Sports"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Anime Card -->
        <FrameLayout
            android:id="@+id/genre_card_anime"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/genre_gradient_anime"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="🎌 Anime"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>
    </GridLayout>
</LinearLayout>
