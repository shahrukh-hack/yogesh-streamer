<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA0B0E14"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="380dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- App Logo / Security Icon -->
        <ImageView
            android:id="@+id/lock_app_logo"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_logo"
            android:contentDescription="Yogesh Streamer" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/lock_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter Master Passcode to Unlock"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- 6-Digit PIN Indicator Dots -->
        <LinearLayout
            android:id="@+id/pin_dots_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/pin_dot_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_5"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_6"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_dot_empty" />
        </LinearLayout>

        <!-- Status / Error message -->
        <TextView
            android:id="@+id/lock_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Incorrect Passcode. Access Denied."
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <!-- Numeric Keypad Grid -->
        <TableLayout
            android:id="@+id/keypad_table"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stretchColumns="*">

            <!-- Row 1: 1, 2, 3 -->
            <TableRow android:layout_marginBottom="8dp">
                <Button
                    android:id="@+id/key_1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
                <Button
                    android:id="@+id/key_2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="2"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
                <Button
                    android:id="@+id/key_3"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="3"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
            </TableRow>

            <!-- Row 2: 4, 5, 6 -->
            <TableRow android:layout_marginBottom="8dp">
                <Button
                    android:id="@+id/key_4"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="4"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
                <Button
                    android:id="@+id/key_5"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="5"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
                <Button
                    android:id="@+id/key_6"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="6"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
            </TableRow>

            <!-- Row 3: 7, 8, 9 -->
            <TableRow android:layout_marginBottom="8dp">
                <Button
                    android:id="@+id/key_7"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="7"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
                <Button
                    android:id="@+id/key_8"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="8"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
                <Button
                    android:id="@+id/key_9"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="9"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
            </TableRow>

            <!-- Row 4: Delete (⌫), 0, Submit (✓) -->
            <TableRow>
                <Button
                    android:id="@+id/key_del"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="⌫"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
                <Button
                    android:id="@+id/key_0"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
                <Button
                    android:id="@+id/key_ok"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_lock_key_button"
                    android:textColor="@color/text_lock_key_selector"
                    android:text="✓"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:focusable="true" />
            </TableRow>
        </TableLayout>

        <!-- Remember This Device Checkbox -->
        <CheckBox
            android:id="@+id/chk_remember_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="Remember this device"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:focusable="true" />

    </LinearLayout>
</LinearLayout>
