<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stylized "Y" and Stream Wave for Yogesh Streamer -->
    <!-- Left Arm of Y -->
    <path android:pathData="M 33,30 L 45,30 L 54,48 L 42,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33"
                android:startY="30"
                android:endX="54"
                android:endY="48"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#6366F1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Arm of Y with embedded Play Triangle -->
    <path android:pathData="M 75,30 L 63,30 L 54,48 L 66,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="75"
                android:startY="30"
                android:endX="54"
                android:endY="48"
                android:type="linear">
                <item android:offset="0.0" android:color="#F43F5E" />
                <item android:offset="1.0" android:color="#A855F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stem of Y -->
    <path android:pathData="M 48,48 L 60,48 L 60,78 L 48,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="48"
                android:endX="60"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#8B5CF6" />
                <item android:offset="1.0" android:color="#06B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Play Triangle Centered -->
    <path android:pathData="M 50,42 L 64,54 L 50,66 Z"
        android:fillColor="#FFFFFF" />

</vector>