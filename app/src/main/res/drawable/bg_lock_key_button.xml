<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on Android TV remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F59E0B" />
            <stroke android:width="2dp" android:color="#FDE68A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Pressed / Clicked -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D97706" />
            <stroke android:width="2dp" android:color="#F59E0B" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
